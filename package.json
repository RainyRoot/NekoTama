{
  "name": "nekotama",
  "version": "0.1.0",
  "description": "Anime desktop pet for Linux — Tamagotchi meets system monitor",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build:watch\" \"wait-on dist/main/main.js && electron .\"",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:watch": "tsc -p tsconfig.main.json --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "anime",
    "desktop-pet",
    "electron",
    "linux",
    "tamagotchi"
  ],
  "author": "rainyroot",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "@pixi/assets": "^7.0.0",
    "electron-store": "^8.1.0",
    "node-cron": "^3.0.0",
    "pixi.js": "^7.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "systeminformation": "^5.0.0"
  },
  "build": {
    "appId": "dev.rainyroot.nekotama",
    "productName": "NekoTama",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "src/assets/**/*",
      "!src/**/*.ts"
    ]
  }
}
